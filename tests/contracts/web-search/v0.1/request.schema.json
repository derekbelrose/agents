{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agents.local/contracts/web-search/v0.1/request.schema.json",
  "title": "Web search request",
  "type": "object",
  "required": ["query"],
  "additionalProperties": false,
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  }
}
