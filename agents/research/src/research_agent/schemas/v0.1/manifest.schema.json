{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agents.local/contracts/v0.1/manifest.schema.json",
  "title": "Research agent manifest",
  "type": "object",
  "required": [
    "protocol_version",
    "name",
    "description",
    "version",
    "input_schema",
    "output_schema",
    "capabilities"
  ],
  "additionalProperties": false,
  "properties": {
    "protocol_version": { "const": "0.1" },
    "name": { "const": "research-agent" },
    "description": { "type": "string", "minLength": 1 },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "input_schema": { "type": "object" },
    "output_schema": { "type": "object" },
    "capabilities": {
      "type": "array",
      "contains": { "const": "research" },
      "minContains": 1,
      "uniqueItems": true
    }
  }
}
